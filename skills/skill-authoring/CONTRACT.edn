(skill-contract
  (name "skill-authoring")
  (v "ημ.skill/skill-authoring@0.2.0")

  (intent "Create or revise skills that load correctly in OpenCode and Codex.")

  (activation
    (priority 50)
    (explicit ["skill:skill-authoring"])
    (triggers ["skill authoring"]))

  (placement-guidance
    {:schema "skill-placement/v1"
     :status :proposed
     :reference "references/placement.md"
     :dimensions [:distribution :execution-location :workload-requirements]
     :native-loader-enforcement :not-implemented
     :native-sync-enforcement :unchanged
     :unannotated-skills :preserve-existing-behavior})

  (governance
    (touch-layer :mutable)
    (non-override [:mission :directives :safety :license :output-shape])
    (requires-user-approval false))
)
