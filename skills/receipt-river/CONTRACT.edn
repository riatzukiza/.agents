(skill-contract
  (name "receipt-river")
  (v "ημ.skill/receipt-river@0.2.2")

  (intent
    "Use an append-only receipts.edn ledger (Receipt River). Tail it regularly and append receipts at phase boundaries, verification, and commits. Ships bb scripts for harness-agnostic file interaction.")

  (activation
    (priority 62)
    (explicit ["skill:receipt-river"])
    (triggers ["receipt river" "receipts.log" "append-only receipts" "tail receipts" "receipts v2"]))

  (governance
    (touch-layer :mutable)
    (non-override [:mission :directives :safety :license :output-shape])
    (requires-user-approval false))

  (effects
    (writes true)
    (network false)
    (commits false))

  (fulfillment-score
    (fn [session]
      (let [receipt-events (get session :receiptEvents [])
            receipts (get session :receipts [])
            event-count (count receipt-events)
            receipt-count (count receipts)
            bootstrap-count (count (filter (fn [e] (= (get e :action) "bootstrap")) receipt-events))
            tail-count (count (filter (fn [e] (= (get e :action) "tail")) receipt-events))
            append-count (count (filter (fn [e] (= (get e :action) "append")) receipt-events))
            validate-count (count (filter (fn [e] (= (get e :action) "validate")) receipt-events))
            base (if (> receipt-count 0) 0.4 0)
            bootstrap-bonus (if (> bootstrap-count 0) 0.2 0)
            tail-bonus (if (> tail-count 0) 0.15 0)
            append-bonus (if (> append-count 0) 0.15 0)
            validate-bonus (if (> validate-count 0) 0.1 0)
            activity-bonus (if (> event-count 3) 0.05 0)
            p (+ base bootstrap-bonus tail-bonus append-bonus validate-bonus activity-bonus)]
        {:p (min p 1.0)
         :evidence {:receipt-events event-count
                    :receipts receipt-count
                    :bootstraps bootstrap-count
                    :tails tail-count
                    :appends append-count
                    :validations validate-count}})))

  (protocol
    (workflow
      ["Discover the project root by walking up from cwd looking for .ημ/ or .git/."
       "Determine the mode: legacy mode when .ημ/receipts/ is absent (the single receipts.edn is the ledger); segmented mode when .ημ/receipts/ exists. A line prefixed 'Legacy mode:' or 'Segmented mode:' applies only to that mode; every other line applies to both modes."
       "Segmented mode: the frozen legacy ledger (project-root receipts.edn or .ημ/receipts.edn — whichever was canonical at migration) must not be appended to, edited or removed; write each new receipt as its own .ημ/receipts/<UTC timestamp>-<id>.edn segment holding exactly one EDN record; never edit, rename or delete a committed segment (corrections are new records). Do not use rr-init.bb, rr-append.bb, rr-tail.bb, or rr-last.bb (monolith-only until union-aware; rr-init.bb --eta-mu would create an empty .ημ/receipts.edn that monolith readers prefer over a frozen project-root ledger)."
       "Legacy mode: if receipts.edn exists, treat it as append-only; never edit past lines."
       "Legacy mode: if receipts.edn is absent and work is non-trivial, create it (rr-init.bb; --eta-mu for .ημ/receipts.edn)."
       "Record a receipt (legacy mode: append a line; segmented mode: write a new segment) at: (1) start, (2) after each phase, (3) after tests/build, (4) after commits/pushes."
       "Before major decisions, regain context from a bounded newest ~20 records of the active union (never every historical segment): in legacy mode, tail receipts.edn; in segmented mode before cutover, read the merged ledger (legacy + .ημ/receipts/) via the repository verifier or a union-aware reader — not rr-tail.bb — ordered by effective time (:ts, else :event/recorded-at, else :event/at), then record identity, interleaving frozen legacy records and #:event segments with no cross-kind precedence; records with no effective-time field sort first. After cutover (README + .ημ/receipts/.cutover-excluded.edn declare archived sources), read only the active union (segments not listed in .cutover-excluded.edn) in canonical Clio topological order and never reload archived legacy or excluded converted source segments; the post-cutover newest-20 is the tail of that Clio order, not an effective-time sort. Do not use the verifier's validation sort. Clio order applies only once every active record is a Clio event, i.e. after the dedicated cutover PR converts every active non-Clio record (legacy, plain segments, and lightweight Receipt River envelopes) into full Clio envelopes and excludes those sources from the active union."
       "Legacy mode: when runtime exposes the receipt_river tool, prefer it over ad-hoc shell writes so receipt format can be validated and audited."
       "Segmented mode: do not use the receipt_river runtime tool until it accepts segment targets (it operates on the per-repo receipts.edn, so its append/tail would write the frozen legacy file or omit segments); write segments by hand or via Clio, and never direct it at the frozen legacy file."
       "Legacy mode: prefer the shipped bb scripts (rr-init.bb, rr-append.bb, rr-tail.bb, rr-last.bb) for direct file interaction."
       "Do not log secrets; keep notes bounded."]))
)

(receipts-contract
  (id "promethean.receipts/v2")
  (file "receipts.edn")
  (append-only true)
  (format :edn)
  (project-aware true)
  (root-marker [".ημ" ".git"])
  (eta-mu-file ".ημ/receipts.edn")
  (scripts ["scripts/rr-init.bb" "scripts/rr-append.bb" "scripts/rr-tail.bb" "scripts/rr-last.bb"])
  (segmented-mode-scripts-forbidden ["scripts/rr-init.bb" "scripts/rr-append.bb" "scripts/rr-tail.bb" "scripts/rr-last.bb"])
  (segmented-mode-tools-forbidden ["receipt_river"])
  (segment-dir ".ημ/receipts")
  ;; One authoritative order for any merged ledger holding a non-Clio record
  ;; (legacy-only, or frozen legacy + Clio/envelope segments during migration).
  ;; event/at covers full Clio events that lack :ts and :event/recorded-at.
  (mixed-ledger-order
    (sort-keys [effective-time record-identity])
    (effective-time [ts event/recorded-at event/at])
    (cross-kind-precedence :none)
    (missing-effective-time :sorts-first)
    (governs [:display :context-recovery-newest-20])
    (applies-when :active-union-still-has-non-clio-record))
  ;; Frozen legacy records are grandfathered: no record-shape validation.
  (legacy-records
    (checks [:edn-parse :record-identity :byte-immutable])
    (shape-validation :grandfathered)
    (corrections :new-adjudication-record))
  ;; Pre-cutover shape validation covers active segment records: plain, the
  ;; lightweight event-envelope, or full-clio-event. Cutover wraps and
  ;; post-cutover writes use full-clio-event; new full-Clio writes need the
  ;; receipt keys, wrap payloads stay grandfathered like their sources.
  (shape-validation-scope
    (pre-cutover :segment-records-via-plain-or-event-envelope-or-full-clio-event)
    (cutover-and-after :full-clio-event)
    (cutover-wrap-payloads :grandfathered)
    (new-full-clio-writes :receipt-required-keys-on-event-data))
  (clio-order
    (applies-when :every-active-record-is-clio-event)
    (algorithm :topological-sort)
    (edges event/causes)
    (tie-break [event/stream event/seq event/id])
    (tie-break-scope :causally-incomparable-events-only))
  ;; The reachable transition from mixed-ledger-order to clio-order.
  (clio-cutover
    (pr :dedicated)
    (convert-every-active-non-clio-record
      (sources [:frozen-legacy-file :plain-segments :receipt-river-envelopes])
      (already-clio-events :promote-verbatim-keep-event-id))
    (wrap-as-full-clio-envelope
      (segment :one-per-record)
      (event-type :receipt-river/receipt-recorded)
      (required-keys [event/id event/schema event/type event/stream event/seq
                      event/causes event/actor event/subject event/at event/data])
      (event/data {:receipt-river/receipt
                   {:plain-receipt :source-record-verbatim
                    :receipt-river-envelope :source-event-payload-verbatim}})
      (event/actor "receipt-river/cutover")
      (event/subject "receipt:<record-identity>")
      (event/at [ts event/recorded-at :cutover-time])
      (schema
        (catalog-published-before-wraps :repository-clio-schema-history)
        (event-schema :names-persisted-revision-root-and-hash)
        (wrap-receipt-schema [:map])
        (new-write-receipt-schema :nine-required-keys-separate-revision)
        (recorded-in ".ημ/receipts/README.md"))
      (event-id
        (receipt-river-envelope-canonical-uuid-string-id :keep-exact-string)
        (algorithm :uuid-v5)
        (namespace-uuid "6ba7b810-9dad-11d1-80b4-00c04fd430c8")
        (name-bytes
          (id-less-plain :utf8-lowercase-hex-sha256-canonical-edn-identity)
          (receipt-river-envelope-non-canonical-id
            {:utf8-prefix "receipt-river/event-id:" :then :canonical-edn-text-of-event-id})))
      (promoted-event-causes :verbatim-fail-closed-if-unresolvable-or-remapped)
      (stream "<repo>/legacy")
      (stream-reserved :fail-closed-if-pre-cutover-union-uses-it)
      (seq :one-based-ordinal-among-wraps-in-pre-cutover-active-union-order)
      (promoted-clio-events :keep-original-stream-and-seq)
      (causes :previous-wrap))
    (legacy-file :archived-source-byte-identical-outside-active-union)
    (converted-source-segments :archived-in-place-via-cutover-excluded-manifest)
    (exclusion-manifest ".ημ/receipts/.cutover-excluded.edn")
    (frozen-after-cutover [".ημ/receipts/.cutover-excluded.edn" :cutover-declaration-in-readme])
    (verify-frozen :byte-identical-to-cutover-commit)
    (post-cutover-active-union :segments-not-listed-in-cutover-excluded)
    (declared-in ".ημ/receipts/README.md")
    (verify :bijection-every-archived-legacy-record-and-pre-cutover-non-clio-source-to-active-clio-event)
    (verify-archived-full-clio :verbatim-active-copy-same-event-id-and-data))
  (record-identity
    (clio-or-event :event/id)
    (id-less-plain-receipt :sha256-canonical-edn-bytes)
    (canonical-edn-bytes
      (canonicalize-children-before-sorting true)
      (map-entries-sorted-by-canonical-key-text true)
      (sets-stay-sets-members-sorted-by-canonical-text true)
      (vectors-and-lists-keep-order-and-bracket true)
      (sort-compare :unicode-code-point)
      (scalars :clojure-pr-str)
      (separator :single-space)
      (hash :sha256-utf8-lowercase-hex-no-separators))
    (id-less-plain-applies-to [:frozen-legacy :plain-segments]))
  (required-keys [ts kind origin owner dod pi host manifest refs])
  (optional-keys [note tests decisions drift])
  ;; Pre-cutover lightweight envelopes: receipt under :event/payload.
  (event-envelope
    (applies-when :pre-cutover)
    (type :receipt-river/receipt-recorded)
    (required-keys [event/id event/type event/recorded-at event/payload])
    (payload-required-keys [ts kind origin owner dod pi host manifest refs])
    (other-event-types :invalid))
  ;; Cutover wraps and post-cutover writes: full Clio shape (not recorded-at/payload).
  (full-clio-event
    (applies-when [:pre-cutover :cutover :post-cutover])
    (type :receipt-river/receipt-recorded)
    (required-keys [event/id event/schema event/type event/stream event/seq
                    event/causes event/actor event/subject event/at event/data])
    (event/data {:receipt-river/receipt :receipt-map})
    (new-write-receipt-required-keys [ts kind origin owner dod pi host manifest refs])
    (cutover-wrap-receipt :grandfathered)
    (new-write-stream :writer-and-branch-or-per-run-unless-serial-allocator)
    (other-event-types :invalid))
  (kinds
    [:push-truth :artifact-hash :test-run :build :decision :drift :catalog
     :observation :field-impact :truth :refutation :adjudication]))
