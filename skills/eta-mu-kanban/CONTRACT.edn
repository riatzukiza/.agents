(skill-contract
  (name "eta-mu-kanban")
  (v "ημ.skill/eta-mu-kanban@0.2.0")

  (intent
    "Operate a Rheos/eta-mu markdown board through the strongest lawful CLI, MCP, connector, or file-only surface; preserve append-only provenance and converge operational ledgers under .ημ/.")

  (activation
    (priority 86)
    (explicit ["skill:eta-mu-kanban" "skill:rheos-kanban"])
    (triggers ["rheos"
               "eta-mu kanban"
               "kanban"
               "task board"
               "move task"
               "board drift"
               "board ledger"
               "kanban migration"
               "work from a card"]))

  (governance
    (touch-layer :mutable)
    (non-override [:mission :directives :safety :license :output-shape])
    (requires-user-approval false))

  (effects
    (writes :conditional)
    (network false)
    (commits false)
    (status-transition :fsm-required))

  (requires
    ["environment-classifier"])

  (protocol
    (surface-order [:rheos-cli :eta-mu-cli :rheos-mcp :repository-connector :file-read-proposal])
    (canonical-ledger-default ".ημ/ledgers/rheos.edn")
    (legacy-ledgers ["kanban/.events/ledger.edn" ".eta-mu/"])
    (forbid ["hand-edit generated board snapshots"
             "bypass FSM through raw status edits"
             "rewrite or discard legacy event history"]))

  (artifacts
    (skill-file "~/.agents/skills/eta-mu-kanban/SKILL.md")
    (contract-file "~/.agents/skills/eta-mu-kanban/CONTRACT.edn")))
