#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:99}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-agent}"
export EMACS_DAEMON_NAME="${EMACS_DAEMON_NAME:-agent-core}"
export XDG_CURRENT_DESKTOP=i3
export XDG_SESSION_TYPE=x11
[[ -f /home/agent/.agent-sandbox-container && "$DISPLAY" == :99 ]] || { echo 'isolated container display :99 required' >&2; exit 1; }
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
mkdir -p /workspace/.artifacts
if [[ -d /inputs/espanso ]]; then
  # Candidate is a read-only snapshot; daemon gets its own writable copy.
  rm -rf "$HOME/.config/espanso"
  mkdir -p "$HOME/.config/espanso"
  cp -a --no-preserve=ownership /inputs/espanso/. "$HOME/.config/espanso/"
  chmod -R u+rwX "$HOME/.config/espanso"
fi

Xvfb "$DISPLAY" -screen 0 1280x800x24 -nolisten tcp >/workspace/.artifacts/xvfb.log 2>&1 &
xvfb_pid=$!
cleanup() {
  # Invoked indirectly by the EXIT/INT/TERM trap.
  # shellcheck disable=SC2317
  kill "${espanso_pid:-}" "${i3_pid:-}" "${emacs_pid:-}" "$xvfb_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

for _ in $(seq 1 50); do xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 && break; sleep 0.1; done
xdpyinfo -display "$DISPLAY" >/dev/null
setxkbmap -display "$DISPLAY" -layout us
i3 >/workspace/.artifacts/i3.log 2>&1 &
i3_pid=$!
for _ in $(seq 1 50); do i3-msg -t get_version >/dev/null 2>&1 && break; sleep 0.1; done
i3-msg -t get_version >/dev/null
emacs --fg-daemon="$EMACS_DAEMON_NAME" >/workspace/.artifacts/emacs.log 2>&1 &
emacs_pid=$!
emacs_budget=5
if [[ "$EMACS_DAEMON_NAME" == agent-spacemacs ]]; then
  emacs_budget="${SPACEMACS_STARTUP_TIMEOUT:-600}"
fi
/home/agent/bin/wait-emacs "$EMACS_DAEMON_NAME" "$emacs_pid" "$emacs_budget"
eval "$(dbus-launch --sh-syntax)"
espanso daemon >/workspace/.artifacts/espanso-daemon.log 2>&1 &
espanso_pid=$!
for _ in $(seq 1 50); do espanso status 2>/dev/null | grep -Fx 'espanso is running' >/dev/null && kill -0 "$espanso_pid" 2>/dev/null && break; sleep 0.1; done
espanso status | tee /workspace/.artifacts/espanso-status.log | grep -Fx 'espanso is running'
kill -0 "$espanso_pid"
set +e
wait -n "$xvfb_pid" "$i3_pid" "$emacs_pid" "$espanso_pid"
status=$?
echo "A required sandbox process exited (status $status); stopping sandbox" >&2
exit 1
