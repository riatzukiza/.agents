(skill-contract
  (name "local-container-registry")
  (v "ημ.skill/local-container-registry@0.2.1")

  (intent
    "Run a local Docker registry, publish reusable CUDA-capable ML base images, and resolve ML container/runtime issues or local ML service setup tasks.")

  (activation
    (priority 76)
    (explicit ["skill:local-container-registry"])
    (triggers ["local registry"
               "docker registry"
               "baked image"
               "base image"
               "ml base image"
               "torch in docker"
               "cuda in docker"
               "libcusparseLt"
               "container ML issue"
               "ml local service"
               "open-hax docker"
               "open-hax proxy container"
               "embeddings docker"
               "local ML service"]))

  (governance
    (touch-layer :mutable)
    (non-override [:mission :directives :safety :license :output-shape])
    (requires-user-approval false))

  (effects
    (writes true)
    (network true)
    (commits false))

  (fulfillment-score
    (fn [session]
      (let [reflections (get session :reflections [])
            skill-events (get session :skillEvents [])
            n (count reflections)
            skill-names (map (fn [e] (get e :skill)) skill-events)
            registry-calls (count (filter (fn [s] (= s "local-container-registry")) skill-names))
            avg-eff (if (> n 0)
                      (/ (reduce + (map (fn [r] (get r :efficiencyP 0.5)) reflections)) n)
                      0.5)
            avg-fric (if (> n 0)
                       (/ (reduce + (map (fn [r] (get r :frictionP 0.5)) reflections)) n)
                       0.5)
            ;; Container ops should be smooth (low friction)
            base-score (* avg-eff (- 1 avg-fric))
            invocation-bonus (if (> registry-calls 0) 0.15 0)
            ;; Low friction = successful container ops
            low-friction-bonus (if (< avg-fric 0.3) 0.1 0)
            p (+ base-score invocation-bonus low-friction-bonus)]
        {:p (min p 1.0)
         :evidence {:turns n
                    :registry-invocations registry-calls
                    :avg-efficiency avg-eff
                    :avg-friction avg-fric}})))

  (protocol
    (workflow
      ["Start and validate a local registry (default localhost:5000)."
       "Prefer official CUDA-capable upstream images over rebuilding the full CUDA stack by hand."
       "Build/tag/push reusable ML base images with stable version tags."
       "Update downstream Dockerfiles/compose to consume the baked base."
       "When the task is a local ML service rather than a general toolbox image, prefer dedicated service images (e.g. Open Hax proxy stack or embeddings inference)."
       "Record registry/image/service decisions clearly so other repos can reuse them"])))