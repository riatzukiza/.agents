(skill-contract
  (name "social-publish-bluesky")
  (v "ημ.skill/social-publish-bluesky@0.2.0")

  (intent "Turn the latest Hormuz clock snapshot into a concise Bluesky post or thread with dry-run-first behavior using the bluesky tool")

  (activation
    (priority 50)
    (explicit ["skill:social-publish-bluesky"])
    (triggers ["social publish bluesky" "post hormuz to bluesky"]))

  (tools ["bluesky"])

  (workflow
    (steps
      [{:step "check-credentials" :env ["BLUESKY_IDENTIFIER" "BLUESKY_APP_PASSWORD"]}
       {:step "read-snapshot" :files ["reports/v4_snapshot.md"]}
       {:step "extract-key-data" :context ["probabilities" "signals" "timeline"]}
       {:step "compress-to-300-chars" :constraint true}
       {:step "post-to-bluesky" :tool "bluesky" :action "post" :or "post-image"}]))

  (constraints
    {:text-length 300
     :image-alt-required true})

  (governance
    (touch-layer :mutable)
    (non-override [:mission :directives :safety :license :output-shape])
    (requires-user-approval false)
    (dry-run-default true)))
